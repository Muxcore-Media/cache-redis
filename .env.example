# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=cache-redis

# Redis
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Module gRPC listen address (default loopback; set explicitly for non-loopback)
# CACHE_GRPC_ADDR=127.0.0.1:9600

# TLS (enabled by default; auto-generated under ~/.muxcore/tls/cache-redis)
# CACHE_REDIS_TLS_CERT=
# CACHE_REDIS_TLS_KEY=
# CACHE_REDIS_TLS_CA=
# CACHE_REDIS_TLS_DIR=

# Dev-only plaintext gRPC (inbound and outbound)
# MUXCORE_INSECURE_DISABLE_TLS=true
