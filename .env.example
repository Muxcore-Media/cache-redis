# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=cache-redis

# Redis
# REDIS_ADDR=localhost:6379
# REDIS_URL=redis://localhost:6379/0
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0

# TLS (optional; rediss:// in REDIS_URL also enables TLS)
# REDIS_TLS=true
# REDIS_TLS_CA_FILE=/path/to/ca.pem
# REDIS_TLS_CERT_FILE=/path/to/client.crt
# REDIS_TLS_KEY_FILE=/path/to/client.key
# REDIS_TLS_SERVER_NAME=redis.example.com
# REDIS_TLS_INSECURE=false

# Namespace keys/channels on shared Redis (strongly recommended)
# CACHE_KEY_PREFIX=muxcore:

# Module listen addresses
# CACHE_GRPC_ADDR=:9600
# CACHE_HTTP_ADDR=127.0.0.1:9601
